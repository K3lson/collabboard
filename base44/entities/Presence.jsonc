{
  "name": "Presence",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "title": "User Email"
    },
    "user_name": {
      "type": "string",
      "title": "User Name"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "last_seen": {
      "type": "string",
      "title": "Last Seen",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "online",
        "away",
        "offline"
      ],
      "default": "online"
    }
  },
  "required": [
    "user_email",
    "user_name"
  ]
}