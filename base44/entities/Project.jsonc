{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Project Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "color": {
      "type": "string",
      "title": "Color",
      "enum": [
        "indigo",
        "emerald",
        "rose",
        "amber",
        "sky",
        "violet"
      ],
      "default": "indigo"
    },
    "members": {
      "type": "array",
      "title": "Members",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "title"
  ]
}